---
// Language gateway: detects the visitor's preferred language (a saved choice
// first, then the browser's Accept-Language via navigator.language) and
// redirects to /en/ or /pt/. Runs synchronously in <head>, before paint, to
// avoid a flash of the wrong language. The meta-refresh + noscript link cover
// crawlers and JS-disabled visitors.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('rqh-lang');
        var lang = saved === 'en' || saved === 'pt' ? saved : null;
        if (!lang) {
          var browserLangs = navigator.languages || [navigator.language || 'en'];
          lang = browserLangs.some(function (l) { return l.toLowerCase().indexOf('pt') === 0; })
            ? 'pt'
            : 'en';
        }
        location.replace('/' + lang + '/' + location.search + location.hash);
      })();
    </script>
  </head>
  <body>
    <noscript>
      <p>
        <a href="/en/">Continue in English</a> · <a href="/pt/">Continuar em Português</a>
      </p>
    </noscript>
  </body>
</html>
