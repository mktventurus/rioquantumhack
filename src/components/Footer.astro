---
// Site footer.
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = translations[lang];
const home = `/${lang}/`;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div>
        <p class="footer-brand">RIO QUANTUM HACK // '26</p>
        <p class="footer-tagline">{t.footer.tagline}</p>
      </div>
      <div class="footer-links">
        <a class="footer-link" href={`${home}#purpose`}>{t.nav.purpose}</a>
        <a class="footer-link" href={`${home}#programme`}>{t.nav.programme}</a>
        <a class="footer-link" href={`${home}#partners`}>{t.nav.partners}</a>
        <a class="footer-link" href={`${home}#participate`}>{t.nav.join}</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="footer-text">{t.footer.credit}</p>
      <p class="footer-text">© {year} Rio Quantum Hack</p>
    </div>
  </div>
</footer>
