---
import type { Lang } from '../i18n/translations';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="lang-switch">
  
    class={`lang-switch-option ${lang === 'en' ? 'lang-switch-option-active' : ''}`}
    href={`${base}/en/`}
    data-lang="en"
  >
    EN
  </a>
  <span class="lang-switch-sep">/</span>
  
    class={`lang-switch-option ${lang === 'pt' ? 'lang-switch-option-active' : ''}`}
    href={`${base}/pt/`}
    data-lang="pt"
  >
    PT
  </a>
</div>
<script>
  // Persist the visitor's manual choice so it wins over auto-detection on
  // their next visit (see the redirect script in src/pages/index.astro).
  document.querySelectorAll('.lang-switch-option').forEach((el) => {
    el.addEventListener('click', () => {
      const lang = el.getAttribute('data-lang');
      if (lang) localStorage.setItem('rqh-lang', lang);
    });
  });
</script>
