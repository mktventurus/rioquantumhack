---
import type { Lang } from '../i18n/translations';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cls = (l: Lang) => `lang-switch-option ${lang === l ? 'lang-switch-option-active' : ''}`;
---
<div class="lang-switch">
  <a class={cls('en')} href={`${base}/en/`} data-lang="en">EN</a>
  <span class="lang-switch-sep">/</span>
  <a class={cls('pt')} href={`${base}/pt/`} data-lang="pt">PT</a>
</div>
<script>
  // Persist the visitor's manual choice so it wins over auto-detection on
  // their next visit (see the redirect script in src/pages/index.astro).
  document.querySelectorAll('.lang-switch-option').forEach((el) => {
    el.addEventListener('click', () => {
      const lang = el.getAttribute('data-lang');
      if (lang) localStorage.setItem('rqh-lang', lang);
    });
  });
</script>
